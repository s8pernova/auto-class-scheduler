# Supabase
SUPABASE_URL=your-url
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SERVICE_KEY=your-service-key

# Redis-backed generated-schedule sessions
REDIS_URL=redis://127.0.0.1:6379/0
GENERATION_SESSION_TTL_SECONDS=1800
GENERATION_SESSION_MAX_RESULTS=10000
GENERATION_SESSION_MAX_BYTES=16777216
GENERATION_PAGE_MAX=100
GENERATION_CACHE_NAMESPACE=course-scheduler:v1

# Ports
BACKEND_PORT=8020
FRONTEND_PORT=80
