{
    "name": "ui",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "api:generate": "npm run api:schema && npm run api:codegen",
        "api:schema": "cd .. && .venv/bin/python scripts/export_openapi.py ui/.openapi/schema.json",
        "api:codegen": "openapi-ts -f openapi-ts.config.ts",
        "dev": "vite",
        "typecheck": "tsc -b",
        "build": "tsc -b && vite build",
        "lint": "eslint .",
        "preview": "vite preview",
        "test": "vitest run",
        "check": "npm test && npm run typecheck && npm run lint && npm run build"
    },
    "dependencies": {
        "@supabase/supabase-js": "^2.106.0",
        "@tailwindcss/vite": "^4.1.18",
        "@tanstack/react-table": "^8.21.3",
        "react": "^19.2.0",
        "react-dom": "^19.2.0",
        "react-icons": "^5.5.0",
        "react-router-dom": "^7.10.1",
        "react-select": "^5.10.2",
        "react-time-picker": "^8.0.3",
        "tailwindcss": "^4.1.18"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.1",
        "@hey-api/openapi-ts": "^0.99.0",
        "@types/node": "^25.9.0",
        "@types/react": "^19.2.5",
        "@types/react-dom": "^19.2.3",
        "@typescript-eslint/eslint-plugin": "^8.59.3",
        "@typescript-eslint/parser": "^8.59.3",
        "@vitejs/plugin-react": "^5.1.1",
        "eslint": "^9.39.1",
        "eslint-plugin-react-hooks": "^7.0.1",
        "eslint-plugin-react-refresh": "^0.4.24",
        "globals": "^16.5.0",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.59.3",
        "vite": "^7.2.4",
        "vitest": "^4.1.10"
    },
    "engines": {
        "node": ">=24.0.0 <25"
    },
    "allowScripts": {
        "esbuild@0.28.1": true
    }
}
